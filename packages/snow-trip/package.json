{
  "name": "dsh-snow-trip",
  "version": "0.1.0",
  "private": true,
  "description": "雪季出行工作台：从持续更新的套餐台账筛选、核算和对比出行方案",
  "type": "module",
  "main": "./lib/server/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/server/service.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./tools": {
      "types": "./lib/types/server/tools.d.ts",
      "default": "./lib/server/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/shared/packages.d.ts"
    },
    "./plan-types": {
      "types": "./lib/types/shared/plans.d.ts"
    },
    "./permissions": "./src/server/permission-policy.js"
  },
  "files": [
    "lib/server",
    "lib/shared",
    "lib/types",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.txt",
    "presets",
    "src/server/permission-policy.js"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/snow-trip/agent.cordis.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-skill",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2",
    "react": "18.3.1",
    "react-day-picker": "9.14.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.7-rc.2",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.2"
  }
}
